# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# O .env NAO vai para o Git (esta no .gitignore). Ele guarda o que muda de
# maquina para maquina e o que e segredo.

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-gerada

# True apenas no seu computador. NUNCA True em producao.
DEBUG=True

# Enderecos pelos quais o site pode ser acessado, separados por virgula.
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite no desenvolvimento. Em producao seria algo como:
#   postgres://usuario:senha@localhost:5432/controle_gastos
DATABASE_URL=sqlite:///db.sqlite3

# E-mail (usado pela recuperacao de senha).
# O padrao abaixo NAO envia nada: imprime a mensagem no terminal onde o
# runserver esta rodando. E o que voce quer em desenvolvimento e em aula.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@controlegastos.local

# Para enviar de verdade, troque o backend e preencha o resto:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=seu-email@gmail.com
#   EMAIL_HOST_PASSWORD=senha-de-app-do-gmail
