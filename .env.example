# Copie este arquivo para .env e preencha os valores:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
#
# O .env NAO vai para o Git (esta no .gitignore).

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-gerada

# True apenas no seu computador. NUNCA True em producao.
DEBUG=True

# Enderecos pelos quais o site pode ser acessado, separados por virgula.
ALLOWED_HOSTS=127.0.0.1,localhost
